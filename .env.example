# Copy to .env and adjust as needed. Defaults match docker-compose.yml.
# Read by app/config.py (pydantic-settings) relative to the process's CWD,
# and passed into the containers by docker-compose.yml's `env_file`.
DATABASE_URL=postgresql+psycopg://stockscreen:stockscreen@localhost:5433/stockscreen
HOURLY_BACKFILL_DAYS=728
DAILY_BACKFILL_PERIOD=5y
INCREMENTAL_OVERLAP_DAYS=2
# Fernet key for broker_accounts credentials/token encryption. Generate with:
# .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_MASTER_KEY=
GROWW_REQUEST_TIMEOUT=30
MATCH_WINDOW_SESSIONS=5
MATCH_MAX_PRICE_GAP_PCT=5.0
CHANDELIER_ATR_MULTIPLE=2.5
SWING_REVIEW_AFTER_SESSIONS=30
UPCOMING_ACTION_WARN_SESSIONS=5
# A symbol with a failed/pending bar_checks row in the last N sessions gets no new signals.
SIGNAL_CHECK_LOOKBACK_SESSIONS=20

# --- docker-compose.yml only (local stack; not read by the app) ----------
# DATABASE_URL above is the *host* view (localhost:5433) used by the venv;
# inside the compose network the DB is db:5432, which the compose file sets
# for the containers. DOCKER_DATABASE_URL overrides that, e.g. to point the
# local containers at a Postgres running outside Docker on this machine
# (`localhost` inside a container is the container itself):
# DOCKER_DATABASE_URL=postgresql+psycopg://stockscreen:stockscreen@host.docker.internal:5432/stockscreen
#
# Credentials for the bundled `db` service.
# POSTGRES_USER=stockscreen
# POSTGRES_PASSWORD=stockscreen
# POSTGRES_DB=stockscreen
# API_PORT=8000
#
# Hosting does not use compose: the image takes DATABASE_URL and the rest as
# plain environment variables from the platform. See docs/RUNBOOK.md §9.

# --- Fyers price feed ------------------------------------------------------
# From the Fyers developer app (myapi.fyers.in). Never commit real values.
# App id, e.g. "XXXX-100".
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
# Must equal the redirect URL registered on the Fyers app: the UI route
# /fyers/callback, e.g. http://localhost:5173/fyers/callback locally or
# https://<host>/fyers/callback when hosted. Users log in daily from Admin.
FYERS_REDIRECT_URI=
FYERS_RPS=3.0
# Local diagnostics only (scripts/fyers_auth.py --write-env writes it; read by
# scripts/probe_intraday_source.py). The app keeps its token in the database.
FYERS_ACCESS_TOKEN=
