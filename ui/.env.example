# Copy this file to .env.local and fill in values for your machine.
# .env.local is git-ignored; never commit real API keys.

# Dev API key: used as a fallback X-API-Key when no key is set in Settings
# (localStorage `ss.apiKey`). Get one from the backend team / CLI script.
VITE_DEV_API_KEY=

# Mock mode: set to 1 to serve /me, /broker-accounts* and /positions* from
# src/api/mock.ts fixtures instead of the real backend (market-data routes
# still hit the real API). Useful because the real DB has no positions yet.
# Run with: VITE_MOCK=1 npm run dev
VITE_MOCK=
